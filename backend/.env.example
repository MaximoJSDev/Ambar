DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="ambar_app"
DB_PASSWORD="REPLACE_WITH_A_PRIVATE_PASSWORD"
DB_NAME=ambar_escolar
JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_VALUE_WITH_AT_LEAST_32_CHARACTERS
# Para TiDB Cloud Starter, usa DB_PORT=4000 y configura la ruta al certificado CA.
# DB_TIDB=true
# DB_SSL_CA=C:/ruta/isrgrootx1.pem
# Para guardar PDF privados, configura juntas estas tres variables:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_REQUIRED=true
